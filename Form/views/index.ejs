<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    
<div>
   
    <form class="bg-white p-6 rounded-md shadow-md" action="submit" method="post">

        <input class="border-zinc-800 flex flex-wrap" type="text" placeholder="name" name="name">
        <input type="email" placeholder="email" name="email" >
        <input type="number" placeholder="age" name="age" >
        <input class="bg-blue-500 " type="submit" value="submit">

    </form>

</div>

</body>
</html>